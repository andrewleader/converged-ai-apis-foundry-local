<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- The tests run on net8.0, where Windows models report NotSupportedOnPlatform (MSAILOCAL101), and have no package manifest (MSAILOCAL103). -->
    <NoWarn>$(NoWarn);MSAILOCAL101;MSAILOCAL103</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)src/Microsoft.AI.Local.TextGeneration/Microsoft.AI.Local.TextGeneration.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Microsoft.AI.Local.TextEmbedding/Microsoft.AI.Local.TextEmbedding.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Microsoft.AI.Local.SpeechToText/Microsoft.AI.Local.SpeechToText.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Microsoft.AI.Local.TextSummarization/Microsoft.AI.Local.TextSummarization.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Microsoft.AI.Local.ImageTextRecognition/Microsoft.AI.Local.ImageTextRecognition.csproj" />
    <ProjectReference Include="$(RepoRoot)src/Microsoft.AI.Local.ImageScaling/Microsoft.AI.Local.ImageScaling.csproj" />
  </ItemGroup>

</Project>
