<Project>
  <ItemGroup Label="Contracts (core)">
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Provider SDKs">
    <PackageVersion Include="Microsoft.WindowsAppSDK.AI" Version="2.5.5" />
    <!-- Microsoft.WindowsAppSDK.Foundation 2.3.12 depends on InteractiveExperiences >= 2.1.8, which was never published (NU1603). -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageVersion Include="Microsoft.AI.Foundry.Local" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup Label="Analyzers and generators">
    <!-- Pinned to the Roslyn version shipped with the .NET 8 SDK so the analyzers load in every supported SDK. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>

  <ItemGroup Label="Samples and tests">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
