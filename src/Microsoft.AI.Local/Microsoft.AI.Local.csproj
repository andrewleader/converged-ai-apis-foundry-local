<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(PortableTargetFramework);$(WindowsTargetFramework)</TargetFrameworks>
    <RootNamespace>Microsoft.AI.Local</RootNamespace>
    <Description>Converged contracts for on-device AI in .NET: one model-acquisition contract and one inference contract per task type (built on Microsoft.Extensions.AI). Pure managed; no native dependencies. Reference a provider package such as Microsoft.AI.Local.Windows or Microsoft.AI.Local.Foundry to get models.</Description>
    <!-- ISpeechToTextClient is experimental in Microsoft.Extensions.AI; our wrappers are marked [Experimental("MSAILOCAL001")]. -->
    <NoWarn>$(NoWarn);MEAI001;MSAILOCAL001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <!-- Windows-only fast paths (SoftwareBitmap, WIC decoding) are compiled only for the Windows target framework. -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' != 'windows'">
    <Compile Remove="**/*.Windows.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'windows'">
    <Compile Remove="**/*.Portable.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Microsoft.AI.Local.Tests" />
  </ItemGroup>

</Project>
