  <!--
    Inputs of the Microsoft.AI.Local analyzers: MSAILOCAL101-103 check executables only (OutputType), and MSAILOCAL101
    checks the target framework.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="OutputType;TargetFramework;TargetPlatformIdentifier" />
  </ItemGroup>
</Project>
