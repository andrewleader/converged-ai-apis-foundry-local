<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Speech-to-text builds on Microsoft.Extensions.AI's experimental ISpeechToTextClient (MEAI001); ours is MSAILOCAL001. -->
    <NoWarn>$(NoWarn);MEAI001;MSAILOCAL001</NoWarn>
  </PropertyGroup>

  <!--
    Package conventions (see PROPOSAL.md §7). A project named Microsoft.AI.Local.<Task> is a task package: the task's
    API, its catalog class, and every provider's models of that task. LocalAIWindowsTasks and LocalAIFoundryTasks list
    the tasks each provider implements (they must match the manifests in eng/catalog). LocalAITask and LocalAIProviders
    drive the references, target frameworks, catalog generation and versions below and in Directory.Build.targets, so
    task projects only declare their description.
  -->
  <PropertyGroup>
    <LocalAITasks>TextGeneration;TextEmbedding;SpeechToText;TextSummarization;TextRewrite;TextToTable;ImageTextRecognition;ImageDescription;ImageScaling;ImageSegmentation;ImageObjectRemoval</LocalAITasks>
    <LocalAIWindowsTasks>TextGeneration;SpeechToText;TextSummarization;TextRewrite;TextToTable;ImageTextRecognition;ImageDescription;ImageScaling;ImageSegmentation;ImageObjectRemoval</LocalAIWindowsTasks>
    <LocalAIFoundryTasks>TextGeneration;TextEmbedding;SpeechToText</LocalAIFoundryTasks>
    <_LocalAIName Condition="$(MSBuildProjectName.StartsWith('Microsoft.AI.Local.'))">$(MSBuildProjectName.Substring(19))</_LocalAIName>
    <LocalAITask Condition="'$(_LocalAIName)' != '' and $([System.String]::Copy(';$(LocalAITasks);').Contains(';$(_LocalAIName);'))">$(_LocalAIName)</LocalAITask>
    <LocalAIUsesWindows Condition="'$(LocalAITask)' != '' and $([System.String]::Copy(';$(LocalAIWindowsTasks);').Contains(';$(LocalAITask);'))">true</LocalAIUsesWindows>
    <LocalAIUsesFoundry Condition="'$(LocalAITask)' != '' and $([System.String]::Copy(';$(LocalAIFoundryTasks);').Contains(';$(LocalAITask);'))">true</LocalAIUsesFoundry>
    <!-- Comma-separated: it reaches the catalog generator through .editorconfig, where ';' starts a comment. -->
    <LocalAIProviders Condition="'$(LocalAIUsesFoundry)' == 'true'">Foundry</LocalAIProviders>
    <LocalAIProviders Condition="'$(LocalAIUsesWindows)' == 'true'">$(LocalAIProviders),Windows</LocalAIProviders>
  </PropertyGroup>

  <PropertyGroup Condition="'$(LocalAITask)' != ''">
    <RootNamespace>Microsoft.AI.Local</RootNamespace>
    <TargetFramework Condition="'$(LocalAIUsesWindows)' != 'true'">$(PortableTargetFramework)</TargetFramework>
    <!-- Tasks with Windows models also build for net8.0, where those models report NotSupportedOnPlatform (PROPOSAL.md §9). -->
    <TargetFrameworks Condition="'$(LocalAIUsesWindows)' == 'true'">$(PortableTargetFramework);$(WindowsTargetFramework)</TargetFrameworks>
  </PropertyGroup>

  <!-- TargetFramework is a global property in each inner build, so Windows-only settings can be applied here. -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)/README.md')">
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <Import Project="$(RepoRoot)eng/Versions.props" />
</Project>
